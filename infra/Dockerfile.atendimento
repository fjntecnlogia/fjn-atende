# Dockerfile do fjn-atendimento
# Build context: ../fjn-atendimento

FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json tsconfig.json ./
# npm install é mais tolerante a lock desatualizado que npm ci
RUN npm install --no-audit --no-fund
COPY src ./src
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY package*.json ./
RUN npm install --omit=dev --no-audit --no-fund && npm cache clean --force
COPY --from=builder /app/dist ./dist
# Os .md de prompts/products precisam estar acessíveis em runtime
COPY src/prompts ./src/prompts
COPY src/products ./src/products

EXPOSE 3001
CMD ["node", "dist/server.js"]
