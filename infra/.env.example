# =====================================================================
# Variáveis do docker-compose
# Renomeie para .env e preencha
#
# Gere strings aleatórias fortes:
#   openssl rand -hex 32     (ou use https://passwordsgenerator.net)
# =====================================================================

# Postgres
POSTGRES_USER=fjn
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE_DE_32_CHARS_OU_MAIS
POSTGRES_DB=fjn_atendimento

# WPP-Connect — chave secreta global do servidor
# Usada pra gerar tokens de sessão. NÃO use a mesma do POSTGRES_PASSWORD.
WPPCONNECT_SECRET_KEY=TROQUE_POR_UMA_CHAVE_ALEATORIA_LONGA

# Webhook token — usado pra validar webhooks do WPP-Connect → fjn-atendimento
# Mesmo valor deve estar em fjn-atendimento/.env (WEBHOOK_TOKEN)
WEBHOOK_TOKEN=TROQUE_POR_OUTRA_CHAVE_ALEATORIA
