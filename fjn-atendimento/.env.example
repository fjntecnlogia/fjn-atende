# === Server ===
PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# === Provider WhatsApp ===
# Valores aceitos: wppconnect (recomendado, ISC) | evolution (AGPL) | ultramsg (pago)
WHATSAPP_PROVIDER=wppconnect

# Token que VOCÊ define para validar webhooks (qualquer string secreta longa)
WEBHOOK_TOKEN=defina_um_token_secreto_aqui

# --- WPP-Connect (preencha se WHATSAPP_PROVIDER=wppconnect) ---
# Self-hosted via Docker. URL interna ao docker-compose.
WPPCONNECT_BASE_URL=http://wppconnect:21465
WPPCONNECT_SECRET_KEY=                  # mesmo valor do infra/.env
WPPCONNECT_SESSION=fjn-atendimento
WPPCONNECT_SESSION_TOKEN=                # opcional — se vazio, gera automaticamente

# --- UltraMsg (preencha se WHATSAPP_PROVIDER=ultramsg) ---
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

# --- Evolution API (preencha se WHATSAPP_PROVIDER=evolution) ---
EVOLUTION_BASE_URL=http://evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=fjn-atendimento

# === Anthropic (Claude) ===
# Pegue em https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# === OpenAI (Whisper para áudio — opcional) ===
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1

# === Banco de dados ===
DATABASE_URL=postgresql://fjn:fjn_senha_forte@postgres:5432/fjn_atendimento

# === Comportamento ===
DEBOUNCE_MS=3000
TYPING_CHARS_PER_SEC=20
HISTORY_LIMIT=20
HANDOFF_NOTIFY_PHONE=5511999999999
HANDOFF_PAUSE_MINUTES=60
