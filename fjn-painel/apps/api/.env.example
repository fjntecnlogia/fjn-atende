# === Server ===
PORT=3100
NODE_ENV=production
LOG_LEVEL=info

# === Banco de dados ===
# IMPORTANTE: mesmo banco do fjn-atendimento!
DATABASE_URL=postgresql://fjn:fjn_senha_forte@postgres:5432/fjn_atendimento

# === Auth ===
JWT_SECRET=troque_isso_por_uma_string_aleatoria_longa_de_32_chars_ou_mais
JWT_EXPIRES=7d

# === CORS ===
WEB_URL=https://painel.fjntecnologia.com.br

# === Caminhos do serviço de atendimento ===
ATENDIMENTO_PATH=/opt/fjn-atendimento

# URL do webhook do fjn-atendimento + token de validação
# (DEVE bater com WEBHOOK_TOKEN no infra/.env e no fjn-atendimento/.env)
ATENDIMENTO_WEBHOOK_URL=http://fjn-atendimento:3001/webhook
WEBHOOK_TOKEN=

# === Provider WhatsApp (espelha fjn-atendimento) ===
WHATSAPP_PROVIDER=wppconnect

# --- WPP-Connect (preencha se WHATSAPP_PROVIDER=wppconnect) ---
WPPCONNECT_BASE_URL=http://wppconnect:21465
WPPCONNECT_SECRET_KEY=
WPPCONNECT_SESSION=fjn-atendimento
WPPCONNECT_SESSION_TOKEN=

# --- UltraMsg (preencha se WHATSAPP_PROVIDER=ultramsg) ---
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

# --- Evolution API (preencha se WHATSAPP_PROVIDER=evolution) ---
EVOLUTION_BASE_URL=http://evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=fjn-atendimento

# === Stripe (compra de crédito pré-pago) ===
# Crie em https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Pegue em Dashboard → Developers → Webhooks → seu endpoint → "Signing secret"
STRIPE_WEBHOOK_SECRET=
# URLs de retorno do Checkout
STRIPE_SUCCESS_URL=https://atende.fjntecnologia.com.br/creditos?status=success
STRIPE_CANCEL_URL=https://atende.fjntecnologia.com.br/creditos?status=canceled

# === Resend (e-mails transacionais: welcome, recibo, saldo baixo) ===
# Crie em https://resend.com/api-keys (free 3k/mês, 100/dia)
# Vazio = e-mails desativados (apenas log no console)
RESEND_API_KEY=
# Remetente. Use um domínio verificado em https://resend.com/domains
RESEND_FROM=FJN Atende <noreply@fjntecnologia.com.br>
# Reply-to: pra onde vão respostas dos e-mails
RESEND_REPLY_TO=fjntecnologia2022@gmail.com
