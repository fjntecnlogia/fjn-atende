# === Server ===
PORT=3100
NODE_ENV=production
LOG_LEVEL=info

# === Banco de dados ===
# IMPORTANTE: mesmo banco do fjn-atendimento!
DATABASE_URL=postgresql://fjn:fjn_senha_forte@postgres:5432/fjn_atendimento

# === Auth ===
JWT_SECRET=troque_isso_por_uma_string_aleatoria_longa_de_32_chars_ou_mais
JWT_EXPIRES=7d

# === CORS ===
WEB_URL=https://painel.fjntecnologia.com.br

# === Caminhos do serviço de atendimento ===
ATENDIMENTO_PATH=/opt/fjn-atendimento

# === Provider WhatsApp (espelha fjn-atendimento) ===
WHATSAPP_PROVIDER=wppconnect

# --- WPP-Connect (preencha se WHATSAPP_PROVIDER=wppconnect) ---
WPPCONNECT_BASE_URL=http://wppconnect:21465
WPPCONNECT_SECRET_KEY=
WPPCONNECT_SESSION=fjn-atendimento
WPPCONNECT_SESSION_TOKEN=

# --- UltraMsg (preencha se WHATSAPP_PROVIDER=ultramsg) ---
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

# --- Evolution API (preencha se WHATSAPP_PROVIDER=evolution) ---
EVOLUTION_BASE_URL=http://evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=fjn-atendimento
