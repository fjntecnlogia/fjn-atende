# =====================================================================
# FJN Atende — Backend Painel (.env.example)
# =====================================================================
# Copie pra .env e preencha. NUNCA commitar .env com valores reais.

# === Server ===
PORT=3100
NODE_ENV=production
LOG_LEVEL=info

# =====================================================================
# BANCO DE DADOS — Postgres 18 local na VPS (ex-Neon)
# =====================================================================
# Desde 30/07/2026 usamos Postgres LOCAL no container atende_pg.
# Conn interna docker (dentro da rede fjn):
DATABASE_URL=postgresql://postgres:SENHA_AQUI@atende_pg:5432/atende
# Conn dev via túnel SSH: postgresql://postgres:SENHA@127.0.0.1:5435/atende
# ⚠️ NÃO usar mais neon.tech (Neon estourou cota free em 2 meses de workers 24/7)

# === Auth ===
JWT_SECRET=troque_isso_por_uma_string_aleatoria_longa_de_32_chars_ou_mais
JWT_EXPIRES=7d

# === CORS ===
WEB_URL=https://atende.fjntecnologia.com.br

# =====================================================================
# ATENDIMENTO (worker IA)
# =====================================================================
ATENDIMENTO_PATH=/opt/fjn-atendimento
ATENDIMENTO_WEBHOOK_URL=http://fjn-atendimento:3001/webhook
# Token compartilhado com fjn-atendimento/.env — DEVE bater
WEBHOOK_TOKEN=

# =====================================================================
# WhatsApp Provider — escolha UMA opção
# =====================================================================
# Valores válidos: wppconnect | evolution | meta_cloud | ultramsg
WHATSAPP_PROVIDER=evolution

# --- Evolution API v2 (recomendado — provider ATIVO desde 30/07/2026) ---
EVOLUTION_BASE_URL=http://evolution-evolution_api-1:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=fjn-atendimento

# --- Meta Cloud API (WhatsApp Business Platform oficial) ---
# Recomendado pra clientes Enterprise que precisam de volume alto sem risco de ban.
# Guia de cadastro: veja docs/guia-meta-whatsapp-business.md
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_BUSINESS_ACCOUNT_ID=
META_WA_APP_SECRET=
META_WA_VERIFY_TOKEN=fjn_meta_verify_token_change_me
META_WA_API_VERSION=v21.0

# --- WPP-Connect (deprecated — mantido pra compat) ---
WPPCONNECT_BASE_URL=http://wppconnect:21465
WPPCONNECT_SECRET_KEY=
WPPCONNECT_SESSION=fjn-atendimento
WPPCONNECT_SESSION_TOKEN=

# --- UltraMsg (não usado hoje) ---
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

# =====================================================================
# Stripe (billing recorrente + crédito pré-pago)
# =====================================================================
# Live mode em produção. Crie em https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Signing secret do webhook (Dashboard → Developers → Webhooks → seu endpoint)
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://atende.fjntecnologia.com.br/creditos?status=success
STRIPE_CANCEL_URL=https://atende.fjntecnologia.com.br/creditos?status=canceled

# =====================================================================
# Resend (e-mails transacionais: welcome, recibo, saldo baixo, onboarding)
# =====================================================================
# Crie em https://resend.com/api-keys (free 3k/mês, 100/dia)
# Vazio = e-mails desativados (apenas log no console — não quebra o sistema)
RESEND_API_KEY=
# Remetente — precisa de domínio verificado em https://resend.com/domains
RESEND_FROM=FJN Atende <noreply@fjntecnologia.com.br>
RESEND_REPLY_TO=fjntecnologia2022@gmail.com

# =====================================================================
# Clicksign (assinatura digital de contratos)
# =====================================================================
# Crie em https://app.clicksign.com/api_tokens (Sandbox grátis)
# Vazio = botão "Enviar pra assinatura" mostra mensagem "não configurado"
CLICKSIGN_API_TOKEN=
CLICKSIGN_BASE_URL=https://app.clicksign.com
CLICKSIGN_WEBHOOK_SECRET=
